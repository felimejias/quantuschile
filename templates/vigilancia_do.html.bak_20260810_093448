<!DOCTYPE html>
<html lang="es">
<head>
  <meta name="description" content="Quantus Radar del Diario Oficial de Chile — Sistema de alerta preventiva 24/7 que te notifica si tu Nombre, RUT o Empresa aparece en edictos, citaciones judiciales, marcas o boletines oficiales.">
  <meta name="keywords" content="Diario Oficial Chile, Alertas RUT, Edictos Judiciales, Notificaciones Judiciales, Ley 21.719, Quantus Intelligence">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vigilancia del Diario Oficial | Quantus Chile</title>
  <link rel="icon" type="image/png" href="{{ url_for('static', filename='quantus-logo-clean.png') }}">
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
  <style>
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(6, 16, 31, 0.88);
      backdrop-filter: blur(8px);
      z-index: 99999;
      align-items: center;
      justify-content: center;
      padding: 20px;
      box-sizing: border-box;
    }
    .modal-card {
      background: #0f172a;
      border: 1px solid rgba(56, 189, 248, 0.35);
      border-radius: 20px;
      width: 100%;
      max-width: 520px;
      padding: 28px;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.7);
      position: relative;
      color: #f8fafc;
      font-family: inherit;
      max-height: 90vh;
      overflow-y: auto;
    }
    .modal-close-btn {
      position: absolute;
      top: 16px; right: 16px;
      background: none; border: none;
      color: #94a3b8; font-size: 26px;
      cursor: pointer; line-height: 1;
    }
    .modal-close-btn:hover { color: #fff; }
    .do-mobile-paybar { display: none; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: 13px; font-weight: 600; color: #cbd5e1; margin-bottom: 6px; }
    .form-control {
      width: 100%; padding: 12px 14px;
      background: #1e293b; border: 1px solid rgba(148,163,184,0.3);
      border-radius: 10px; color: #fff; font-size: 14px;
      box-sizing: border-box; outline: none; transition: border-color 0.2s;
    }
    .form-control:focus { border-color: #38bdf8; box-shadow: 0 0 0 3px rgba(56,189,248,0.2); }
    .btn-submit-pre {
      width: 100%; padding: 14px;
      background: linear-gradient(135deg, #009ee3 0%, #007eb5 100%);
      color: #fff; border: none; border-radius: 12px;
      font-weight: 700; font-size: 15px; cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      margin-top: 20px; box-shadow: 0 4px 14px rgba(0,158,227,0.4);
    }
    .btn-submit-pre:hover { opacity: 0.95; transform: translateY(-1px); }
    .pay-option-card {
      border: 1px solid rgba(148, 163, 184, 0.2);
      border-radius: 10px;
      padding: 12px;
      margin-bottom: 10px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 12px;
      transition: all 0.2s;
      background: #1e293b;
    }
	    .pay-option-card:hover, .pay-option-card.active {
	      border-color: #38bdf8;
	      background: rgba(56, 189, 248, 0.1);
	    }
	    .do-intel-hero {
	      position: relative;
	      isolation: isolate;
	      overflow: hidden;
	      min-height: calc(100vh - 80px);
	      padding: 54px 0 80px;
	      background: #ffffff;
	      color: #0f172a;
	    }
	    .do-intel-hero::before {
	      display: none;
	    }
	    .do-intel-hero::after {
	      display: none;
	    }
	    .do-intel-shell {
	      width: min(calc(100% - 64px), 1320px);
	      margin: 0 auto;
	      display: grid;
	      grid-template-columns: minmax(0, 1fr) minmax(430px, 0.82fr);
	      gap: clamp(58px, 6vw, 96px);
	      align-items: start;
	    }
	    .do-intel-copy {
	      align-self: start;
	      padding-top: 0;
	      max-width: 720px;
	    }
	    .do-intel-copy h1 {
	      margin: 0 0 24px;
	      max-width: 720px;
	      color: #0f172a;
	      font-size: clamp(52px, 5vw, 76px);
	      line-height: 1.02;
	      letter-spacing: -0.04em;
	      text-wrap: balance;
	    }
	    .do-intel-copy h1 span {
	      color: #0284c7;
	    }
	    .do-intel-lead {
	      max-width: 640px;
	      margin: 0;
	      color: #475569;
	      font-size: clamp(17px, 1.8vw, 21px);
	      line-height: 1.55;
	      font-weight: 650;
	    }
	    .do-intel-actions {
	      display: flex;
	      align-items: center;
	      gap: 12px;
	      flex-wrap: wrap;
	      margin-top: 24px;
	    }
	    .do-primary-action,
	    .do-secondary-action {
	      min-height: 48px;
	      display: inline-flex;
	      align-items: center;
	      justify-content: center;
	      border-radius: 14px;
	      padding: 0 18px;
	      font-size: 14px;
	      font-weight: 900;
	      text-decoration: none;
	    }
	    .do-primary-action {
	      background: #0284c7;
	      color: #ffffff;
	      box-shadow: 0 12px 30px rgba(2,132,199,0.3);
	    }
	    .do-secondary-action {
	      color: #0f172a;
	      border: 1.5px solid #cbd5e1;
	      background: #f8fafc;
	    }
	    .do-hero-proof {
	      display: grid;
	      grid-template-columns: repeat(3, minmax(0, 1fr));
	      gap: 10px;
	      margin-top: 26px;
	      max-width: 690px;
	    }
	    .do-proof-card {
	      border: 1.5px solid #e2e8f0;
	      background: #f8fafc;
	      border-radius: 16px;
	      padding: 14px;
	      min-height: 112px;
	      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
	    }
	    .do-proof-card strong {
	      display: block;
	      color: #0f172a;
	      font-size: 15px;
	      line-height: 1.2;
	      margin-bottom: 7px;
	    }
	    .do-proof-card span {
	      display: block;
	      color: #64748b;
	      font-size: 13px;
	      line-height: 1.38;
	      font-weight: 650;
	    }
	    .do-command {
	      display: grid;
	      gap: 14px;
	      align-self: center;
	      width: 100%;
	      max-width: 520px;
	      justify-self: end;
	    }
	    .do-signal-card,
	    .do-ai-card,
	    .do-lawyer-card {
	      border: 1px solid rgba(125, 211, 252, 0.24);
	      background: rgba(8, 20, 38, 0.82);
	      box-shadow: 0 28px 70px rgba(2, 8, 23, 0.36);
	      backdrop-filter: blur(14px);
	      border-radius: 22px;
	      padding: 16px;
	    }
	    .do-signal-top,
	    .do-ai-top,
	    .do-lawyer-top {
	      display: flex;
	      align-items: center;
	      justify-content: space-between;
	      gap: 12px;
	      margin-bottom: 12px;
	    }
	    .do-signal-title,
	    .do-ai-title,
	    .do-lawyer-title {
	      color: #f8fafc;
	      font-size: 15px;
	      font-weight: 900;
	    }
	    .do-status-pill {
	      border-radius: 999px;
	      padding: 7px 10px;
	      background: rgba(34, 197, 94, 0.14);
	      border: 1px solid rgba(34, 197, 94, 0.32);
	      color: #bbf7d0;
	      font-size: 11px;
	      font-weight: 900;
	      letter-spacing: .4px;
	      text-transform: uppercase;
	    }
	    .do-signal-list {
	      display: grid;
	      gap: 9px;
	    }
	    .do-radar-dial {
	      position: relative;
	      width: min(190px, 48vw);
	      aspect-ratio: 1;
	      margin: 8px auto 2px;
	      border-radius: 999px;
	      border: 1px solid rgba(125, 211, 252, 0.28);
	      background:
	        linear-gradient(rgba(125, 211, 252, 0.13) 1px, transparent 1px),
	        linear-gradient(90deg, rgba(125, 211, 252, 0.13) 1px, transparent 1px),
	        radial-gradient(circle, rgba(14,165,233,0.24) 0 2px, transparent 3px),
	        radial-gradient(circle, rgba(8,145,178,0.16), rgba(15,23,42,0.22) 62%, transparent 63%);
	      background-size: 32px 32px, 32px 32px, auto, auto;
	      overflow: hidden;
	      box-shadow: inset 0 0 38px rgba(14,165,233,0.16), 0 18px 44px rgba(2,8,23,0.26);
	    }
	    .do-radar-dial::before {
	      content: "";
	      position: absolute;
	      inset: 50% 0 0 50%;
	      width: 50%;
	      height: 50%;
	      transform-origin: 0 0;
	      background: conic-gradient(from -18deg, rgba(56,189,248,0.58), rgba(56,189,248,0.12), transparent 46deg);
	      animation: doRadarSweep 4s linear infinite;
	    }
	    .do-radar-dial::after {
	      content: "";
	      position: absolute;
	      inset: 18%;
	      border-radius: inherit;
	      border: 1px solid rgba(125, 211, 252, 0.24);
	      box-shadow: 0 0 0 28px rgba(14,165,233,0.04), 0 0 0 58px rgba(14,165,233,0.025);
	      animation: doRadarPulse 2.8s ease-in-out infinite;
	    }
	    .do-radar-dot {
	      position: absolute;
	      width: 8px;
	      height: 8px;
	      border-radius: 999px;
	      background: #7dd3fc;
	      box-shadow: 0 0 16px rgba(125, 211, 252, 0.95);
	    }
	    .do-radar-dot.one { left: 63%; top: 31%; }
	    .do-radar-dot.two { left: 35%; top: 58%; }
	    .do-radar-dot.three { left: 72%; top: 68%; }
	    .do-signal-row {
	      display: grid;
	      grid-template-columns: 38px 1fr auto;
	      gap: 10px;
	      align-items: center;
	      padding: 10px;
	      border-radius: 15px;
	      background: rgba(15, 23, 42, 0.72);
	      border: 1px solid rgba(148, 163, 184, 0.16);
	      animation: signalLift 5.2s ease-in-out infinite;
	    }
	    .do-signal-row:nth-child(2) { animation-delay: .5s; }
	    .do-signal-row:nth-child(3) { animation-delay: 1s; }
	    .do-signal-icon {
	      width: 38px;
	      height: 38px;
	      display: grid;
	      place-items: center;
	      border-radius: 12px;
	      background: #e0f2fe;
	      color: #075985;
	      font-weight: 900;
	    }
	    .do-signal-row strong,
	    .do-signal-row span {
	      display: block;
	    }
	    .do-signal-row strong {
	      color: #f8fafc;
	      font-size: 14px;
	      line-height: 1.1;
	    }
	    .do-signal-row span {
	      color: #94a3b8;
	      font-size: 12px;
	      font-weight: 650;
	      line-height: 1.35;
	      margin-top: 3px;
	    }
	    .do-risk-badge {
	      border-radius: 999px;
	      padding: 7px 9px;
	      background: rgba(251, 191, 36, 0.16);
	      color: #fde68a;
	      font-size: 11px;
	      font-weight: 900;
	      white-space: nowrap;
	    }
	    .do-ai-flow {
	      display: grid;
	      grid-template-columns: repeat(3, minmax(0, 1fr));
	      gap: 8px;
	    }
	    .do-ai-step {
	      min-height: 76px;
	      border-radius: 14px;
	      padding: 12px;
	      background: rgba(2, 132, 199, 0.12);
	      border: 1px solid rgba(56, 189, 248, 0.2);
	      color: #dbeafe;
	      font-size: 12px;
	      font-weight: 800;
	      line-height: 1.28;
	    }
	    .do-ai-step strong {
	      display: block;
	      color: #7dd3fc;
	      font-size: 11px;
	      text-transform: uppercase;
	      letter-spacing: .6px;
	      margin-bottom: 5px;
	    }
	    .do-lawyer-card {
	      display: grid;
	      grid-template-columns: minmax(0, 1fr) 126px;
	      gap: 12px;
	      align-items: center;
	    }
	    .do-lawyer-card p {
	      margin: 0;
	      color: #cbd5e1;
	      font-size: 13px;
	      line-height: 1.45;
	      font-weight: 650;
	    }
	    .do-mini-video {
	      width: 100%;
	      border-radius: 18px;
	      padding: 6px;
	      background: #020617;
	      border: 1px solid rgba(148, 163, 184, 0.18);
	    }
	    .do-mini-video video {
	      display: block;
	      width: 100%;
	      aspect-ratio: 9 / 16;
	      object-fit: cover;
	      border-radius: 13px;
	    }
	    @keyframes signalLift {
	      0%, 100% { transform: translateY(0); border-color: rgba(148,163,184,0.16); }
	      50% { transform: translateY(-4px); border-color: rgba(56,189,248,0.34); }
	    }
	    @keyframes doRadarSweep {
	      from { transform: rotate(0deg); }
	      to { transform: rotate(360deg); }
	    }
	    @keyframes doRadarPulse {
	      0%, 100% { opacity: .7; transform: scale(.96); }
	      50% { opacity: 1; transform: scale(1.02); }
	    }
	    .do-tip-hero {
	      margin-top: 26px;
	      display: grid;
	      grid-template-columns: 1fr auto;
	      gap: 18px;
	      align-items: center;
	      background: linear-gradient(135deg, rgba(56,189,248,0.14), rgba(16,185,129,0.09));
	      border: 1px solid rgba(56,189,248,0.34);
	      border-radius: 22px;
	      padding: 18px;
	      box-shadow: 0 22px 60px rgba(2, 132, 199, 0.16);
	      text-align: left;
	    }
	    .do-tip-hero strong {
	      display: block;
	      color: #f8fafc;
	      font-size: clamp(18px, 2vw, 24px);
	      line-height: 1.18;
	      margin-bottom: 6px;
	    }
	    .do-tip-hero span {
	      display: block;
	      color: #cbd5e1;
	      font-size: 14px;
	      line-height: 1.55;
	      font-weight: 650;
	    }
	    .do-tip-hero a {
	      display: inline-flex;
	      align-items: center;
	      justify-content: center;
	      min-height: 46px;
	      padding: 0 16px;
	      border-radius: 14px;
	      background: #38bdf8;
	      color: #082f49;
	      text-decoration: none;
	      font-weight: 900;
	      white-space: nowrap;
	      box-shadow: 0 16px 34px rgba(56,189,248,0.24);
	    }
	    .do-demo-section {
	      padding: clamp(42px, 6vw, 74px) 0;
	      background: #f8fbff;
	      color: #0f172a;
	    }
	    .do-demo-shell {
	      max-width: 1120px;
	      margin: 0 auto;
	      padding: 0 20px;
	      display: grid;
	      grid-template-columns: minmax(0, 1fr) minmax(260px, 360px);
	      gap: 34px;
	      align-items: center;
	    }
	    .do-demo-copy { max-width: 650px; }
	    .do-demo-label {
	      display: inline-flex;
	      align-items: center;
	      min-height: 34px;
	      padding: 0 12px;
	      border-radius: 999px;
	      background: #e0f2fe;
	      color: #075985;
	      font-size: 12px;
	      font-weight: 900;
	      letter-spacing: .7px;
	      text-transform: uppercase;
	    }
	    .do-demo-copy h2 {
	      margin: 16px 0 12px;
	      color: #06101f;
	      font-size: clamp(30px, 4vw, 52px);
	      line-height: 1;
	      letter-spacing: 0;
	    }
	    .do-demo-copy p {
	      margin: 0;
	      color: #475569;
	      font-size: 17px;
	      line-height: 1.65;
	      font-weight: 650;
	    }
	    .do-demo-points {
	      display: grid;
	      grid-template-columns: repeat(2, minmax(0, 1fr));
	      gap: 12px;
	      margin-top: 22px;
	    }
	    .do-demo-point {
	      border: 1px solid #dbeafe;
	      background: #fff;
	      border-radius: 14px;
	      padding: 14px;
	      color: #334155;
	      font-size: 14px;
	      font-weight: 750;
	      line-height: 1.35;
	      box-shadow: 0 14px 40px rgba(15, 23, 42, 0.05);
	    }
	    .do-video-frame {
	      width: 100%;
	      max-width: 360px;
	      justify-self: center;
	      border-radius: 28px;
	      padding: 10px;
	      background: #06101f;
	      box-shadow: 0 30px 70px rgba(2, 8, 23, 0.22);
	      border: 1px solid rgba(14, 165, 233, 0.25);
	    }
	    .do-video-frame video {
	      display: block;
	      width: 100%;
	      aspect-ratio: 9 / 16;
	      object-fit: cover;
	      border-radius: 20px;
	      background: #06101f;
	    }
	    .do-tips-section {
	      padding: clamp(42px, 7vw, 82px) 0;
	      border-top: 1px solid rgba(255,255,255,0.08);
	      border-bottom: 1px solid rgba(255,255,255,0.08);
	    }
	    .do-tips-shell {
	      max-width: 1180px;
	      margin: 0 auto;
	      padding: 0 20px;
	    }
	    .do-tips-head {
	      display: grid;
	      grid-template-columns: minmax(0, 0.9fr) minmax(280px, 0.62fr);
	      gap: 28px;
	      align-items: end;
	      margin-bottom: 26px;
	    }
	    .do-kicker {
	      color: #38bdf8;
	      font-size: 12px;
	      letter-spacing: 1.5px;
	      text-transform: uppercase;
	      font-weight: 900;
	      margin-bottom: 10px;
	    }
	    .do-tips-head h2 {
	      margin: 0;
	      color: #f8fafc;
	      font-size: clamp(34px, 5vw, 62px);
	      line-height: 1.02;
	      letter-spacing: 0;
	    }
	    .do-tips-head p,
	    .do-source-note p {
	      margin: 0;
	      color: #cbd5e1;
	      font-size: 16px;
	      line-height: 1.6;
	      font-weight: 650;
	    }
	    .do-source-note {
	      border: 1px solid rgba(148,163,184,0.22);
	      border-radius: 18px;
	      background: rgba(15,23,42,0.72);
	      padding: 18px;
	    }
	    .do-source-note strong {
	      display: block;
	      color: #f8fafc;
	      font-size: 15px;
	      margin-bottom: 8px;
	    }
	    .do-tip-grid {
	      display: grid;
	      grid-template-columns: repeat(4, minmax(0, 1fr));
	      gap: 14px;
	    }
	    .do-tip-card {
	      min-height: 238px;
	      display: flex;
	      flex-direction: column;
	      justify-content: space-between;
	      border: 1px solid rgba(148,163,184,0.2);
	      border-radius: 18px;
	      background: rgba(15,23,42,0.82);
	      padding: 18px;
	      box-shadow: 0 22px 54px rgba(0,0,0,0.22);
	    }
	    .do-tip-card .tag {
	      width: fit-content;
	      color: #bae6fd;
	      border: 1px solid rgba(56,189,248,0.34);
	      background: rgba(56,189,248,0.1);
	      border-radius: 999px;
	      padding: 6px 9px;
	      font-size: 11px;
	      font-weight: 900;
	      margin-bottom: 14px;
	    }
	    .do-tip-card h3 {
	      margin: 0;
	      color: #f8fafc;
	      font-size: 19px;
	      line-height: 1.15;
	    }
	    .do-tip-card p {
	      color: #cbd5e1;
	      font-size: 14px;
	      line-height: 1.55;
	      font-weight: 620;
	      margin: 12px 0 0;
	    }
	    .do-tip-card .action {
	      margin-top: 18px;
	      color: #7dd3fc;
	      font-size: 13px;
	      font-weight: 900;
	    }
	    .do-timeline {
	      margin-top: 18px;
	      display: grid;
	      grid-template-columns: repeat(3, minmax(0, 1fr));
	      gap: 12px;
	    }
	    #planes .pricing-grid {
	      align-items: stretch;
	    }
	    #planes .plan-card {
	      transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
	    }
	    #planes .plan-card:hover {
	      transform: translateY(-4px);
	      box-shadow: 0 24px 54px rgba(14, 165, 233, 0.16);
	    }
	    .do-time-chip {
	      border: 1px solid rgba(16,185,129,0.32);
	      border-radius: 16px;
	      background: rgba(16,185,129,0.1);
	      padding: 14px;
	    }
	    .do-time-chip strong {
	      display: block;
	      color: #bbf7d0;
	      font-size: 15px;
	      margin-bottom: 5px;
	    }
	    .do-time-chip span {
	      display: block;
	      color: #cbd5e1;
	      font-size: 13px;
	      line-height: 1.45;
	      font-weight: 650;
	    }
	    body .app-container {
	      width: 100%;
	      max-width: none;
	      padding: 0;
	    }
	    #planes .container {
	      width: min(1200px, calc(100% - 48px));
	      margin: 0 auto;
	    }
	    section[id] {
	      scroll-margin-top: 96px;
	    }
	    @media (max-width: 1200px) {
	      .do-intel-shell {
	        grid-template-columns: minmax(0, 1fr) minmax(390px, 0.8fr);
	        gap: 48px;
	      }
	    }
	    @media (max-width: 1024px) {
	      .do-intel-shell { grid-template-columns: 1fr; gap: 52px; }
	      .do-hero-proof { grid-template-columns: 1fr; }
	      .do-command {
	        max-width: none;
	        justify-self: stretch;
	      }
	      .do-tips-head,
	      .do-tip-hero { grid-template-columns: 1fr; }
	      .do-demo-shell { grid-template-columns: 1fr; }
