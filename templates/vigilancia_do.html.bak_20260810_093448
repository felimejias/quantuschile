            </label>
          </div>

          <div id="pre-msg-error" style="display:none; padding:12px; background:rgba(239,68,68,0.15); border:1px solid #ef4444; border-radius:10px; color:#fca5a5; font-size:13px; margin-bottom:16px; line-height:1.45;"></div>

          <button type="submit" id="btn-pre-submit" class="btn-submit-pre">
            <img src="{{ url_for('static', filename='mercado-pago-mark.svg') }}" alt="" aria-hidden="true" style="height:20px;"> Validar Datos & Continuar al Pago
          </button>
        </form>
      </div>
    </div>

    <!-- Modal Informativo Legal Ley 21.719 -->
    <div id="modal-ley-21719" class="modal-overlay">
      <div class="modal-card">
        <button type="button" class="modal-close-btn" onclick="cerrarModalLey21719()">&times;</button>
        
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:14px;">
          <span style="background:rgba(56,189,248,0.2); color:#38bdf8; padding:4px 10px; border-radius:999px; font-size:11px; font-weight:800;">NORMATIVA OFICIAL CHILE</span>
          <h3 style="font-size:18px; color:#f8fafc; margin:0;">Política de Datos Personales Ley 21.719</h3>
        </div>

        <div style="color:#cbd5e1; font-size:13px; line-height:1.6;">
          <p><strong>1. Finalidad Exclusiva del Tratamiento:</strong><br>
          Los datos personales recopilados (RUT, Nombre/Razón Social, Correo Electrónico y WhatsApp) serán tratados por <strong>Quantus Chile SpA</strong> únicamente para ejecutar el servicio automatizado de escaneo en el Diario Oficial de Chile y remitir alertas preventivas sobre publicaciones asociadas al RUT del titular.</p>
          
          <p><strong>2. Legitimidad y Consentimiento Expreso:</strong><br>
          De conformidad con la Ley N° 21.719 que modifica la Ley N° 19.628 de Protección de la Vida Privada, el titular otorga su autorización previa, explícita e informada al marcar la casilla de verificación correspondiente.</p>
          
          <p><strong>3. Derechos ARCO (Acceso, Rectificación, Cancelación y Oposición):</strong><br>
          El titular podrá ejercer en todo momento sus derechos legales escribiendo a nuestro correo oficial de protección de datos: <a href="mailto:privacidad@quantuschile.cl" style="color:#38bdf8; font-weight:700;">privacidad@quantuschile.cl</a>.</p>

          <p><strong>4. Advertencia sobre calidad de la fuente Diario Oficial:</strong><br>
          Las publicaciones oficiales pueden contener RUT mal digitado, omitir RUT, abreviar nombres, usar razones sociales antiguas o referirse a representantes legales. Quantus usa búsqueda multicriterio y puede enviar alertas por coincidencia parcial o alta probabilidad, pero no puede garantizar cero falsos positivos ni cero falsos negativos cuando la publicación oficial impide una vinculación razonable.</p>
        </div>

        <button type="button" onclick="cerrarModalLey21719()" style="width:100%; padding:12px; background:#38bdf8; color:#0f172a; border:none; border-radius:10px; font-weight:800; font-size:14px; cursor:pointer; margin-top:20px;">
          Entendido / Cerrar
        </button>
      </div>
    </div>

  </div>

  <script src="{{ url_for('static', filename='rut-validator.js') }}?v=20260729-rut"></script>
  <script>
    function setPaymentMode(mode) {
      var cards = document.querySelectorAll('.pay-option-card');
      cards.forEach(function(c) { c.classList.remove('active'); });
      var selectedRadio = document.querySelector('input[name="payment_mode"][value="' + mode + '"]');
      if (selectedRadio) {
        selectedRadio.checked = true;
        selectedRadio.closest('.pay-option-card').classList.add('active');
      }
    }

    function abrirModalPrePago(plan) {
      console.log("Abriendo modal para plan:", plan);
      var modal = document.getElementById("modal-pre-pago");
      var planInput = document.getElementById("pre-plan");
      if (planInput) planInput.value = plan;
      if (modal) {
        modal.style.display = "flex";
      }
    }

    function cerrarModalPrePago() {
      var modal = document.getElementById("modal-pre-pago");
      if (modal) {
        modal.style.display = "none";
      }
    }

    function abrirModalLey21719(event) {
      if (event) event.preventDefault();
      var modal = document.getElementById("modal-ley-21719");
      if (modal) {
        modal.style.display = "flex";
      }
    }

    function cerrarModalLey21719() {
      var modal = document.getElementById("modal-ley-21719");
      if (modal) {
        modal.style.display = "none";
      }
    }

    async function procesarPrePago(event) {
      event.preventDefault();
      var btn = document.getElementById("btn-pre-submit");
      var errDiv = document.getElementById("pre-msg-error");
      var form = document.getElementById("form-pre-pago");
      var consentChk = document.getElementById("pre-consent");
      var sourceLimitsChk = document.getElementById("pre-source-limits");

      function showPreMessage(type, html) {
        if (!errDiv) return;
        var styles = {
          error: ["rgba(239,68,68,0.22)", "#ef4444", "#ffffff"],
          alert_red: ["rgba(239,68,68,0.25)", "#ef4444", "#ffffff"],
          warn: ["rgba(245,158,11,0.20)", "#f59e0b", "#fde68a"],
          ok: ["rgba(16,185,129,0.20)", "#10b981", "#bbf7d0"]
        };
        var selected = styles[type] || styles.error;
        errDiv.style.display = "block";
        errDiv.style.background = selected[0];
        errDiv.style.borderColor = selected[1];
        errDiv.style.color = selected[2];
        errDiv.style.borderWidth = "1.5px";
        errDiv.style.borderStyle = "solid";
        errDiv.style.padding = "14px 18px";
        errDiv.style.borderRadius = "14px";
        errDiv.style.fontSize = "13.5px";
        errDiv.style.lineHeight = "1.45";
        errDiv.innerHTML = html;
      }

      if (consentChk && !consentChk.checked) {
        showPreMessage("warn", "<strong>Debes aceptar expresamente la Política de Datos Personales (Ley 21.719) para continuar.</strong>");
        return false;
      }

      if (sourceLimitsChk && !sourceLimitsChk.checked) {
        showPreMessage("warn", "<strong>Debes aceptar la advertencia sobre posibles errores u omisiones del Diario Oficial para continuar.</strong>");
        return false;
      }

      if (errDiv) errDiv.style.display = "none";
      if (btn) {
        btn.disabled = true;
        btn.textContent = "Validando suscripción...";
      }

      var formData = new FormData(form);
      var csrfToken = form.querySelector('input[name="_csrf_token"]')?.value || "";

      try {
        var res = await fetch("/api/validar_suscripcion_previa", {
          method: "POST",
          headers: {
            "X-CSRFToken": csrfToken
          },
          body: formData
        });
        var data = await res.json();

        if (!res.ok && !data.registrado) {
          showPreMessage("error", "<strong>" + (data.message || "No pudimos validar los datos. Revisa el formulario e inténtalo nuevamente.") + "</strong>");
          if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<img src="/static/mercado-pago-mark.svg" alt="" aria-hidden="true" style="height:20px;"> Validar Datos & Continuar al Pago';
          }
          return false;
        }

        if (data.registrado && data.status === "ya_registrado") {
          showPreMessage("alert_red", "<strong>" + (data.message || "Este RUT o correo ya tiene una vigilancia activa. No realizaremos un nuevo cobro.") + "</strong>");
          if (btn) {
            btn.disabled = false;
            btn.style.background = "linear-gradient(135deg, #ef4444 0%, #dc2626 100%)";
            btn.style.color = "#ffffff";
            btn.style.borderColor = "#ef4444";
            btn.style.boxShadow = "0 6px 20px rgba(239, 68, 68, 0.4)";
            btn.innerHTML = "Vigilancia ya activa";
          }
          return false;
        }

        if (data.status === "pago_pendiente") {
          showPreMessage("warn", "<strong>" + (data.message || "Ya existe una solicitud pendiente de pago.") + "</strong><br>Si ya pagaste, no vuelvas a pagar: espera la confirmación de activación.");
          if (data.checkout_url) {
            setTimeout(function() { window.location.href = data.checkout_url; }, 1800);
          }
          return false;
        }

        if (data.checkout_url) {
          showPreMessage("ok", "<strong>" + (data.message || "Datos validados. Redirigiendo al pago seguro...") + "</strong>");
          setTimeout(function() { window.location.href = data.checkout_url; }, 700);
          return false;
        }

        showPreMessage("error", "<strong>No recibimos un enlace de pago válido. Te contactaremos para completar la activación.</strong>");
        if (btn) {
          btn.disabled = false;
	          btn.innerHTML = '<img src="/static/mercado-pago-mark.svg" alt="" aria-hidden="true" style="height:20px;"> Validar Datos & Continuar al Pago';
        }
        return false;
      } catch (err) {
        console.error("Error validando:", err);
        showPreMessage("error", "<strong>No pudimos validar la suscripción en este momento.</strong><br>Revisa tu conexión e inténtalo nuevamente.");
        if (btn) {
          btn.disabled = false;
	          btn.innerHTML = '<img src="/static/mercado-pago-mark.svg" alt="" aria-hidden="true" style="height:20px;"> Validar Datos & Continuar al Pago';
        }
        return false;
      }
    }

    document.addEventListener("DOMContentLoaded", function() {
      var btns = document.querySelectorAll(".mp-pay-button");
      btns.forEach(function(b) {
        b.addEventListener("click", function(e) {
          e.preventDefault();
          var p = b.getAttribute("data-plan") || "mensual";
          abrirModalPrePago(p);
        });
      });
    });
  </script>
</body>
</html>
