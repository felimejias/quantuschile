                <div class="company-rubro-text">{{ company.rubro }}</div>
                <div class="brand-note-line">{{ company.brand_label }} · {{ company.brand_note }}</div>

                <div class="company-meta-grid">
                  <div class="meta-col"><span>RUT:</span><strong>{{ company.rut }}</strong></div>
                  <div class="meta-col"><span>Plan:</span><strong>{{ company.plan }}</strong></div>
                  <div class="meta-col"><span>Vence:</span><strong>{{ company.expires }}</strong></div>
                </div>
              </div>
              <form action="/pos/seleccionar/{{ company.key }}" method="POST">
                {{ csrf_input()|safe }}
                <button type="submit" class="btn-enter-company">Ingresar</button>
              </form>
            </div>
            {% else %}
