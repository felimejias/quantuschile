  <script>
    function actualizarContadorLicitaciones() {
      var rubro = document.getElementById("rubro-select").value;
      var reg = document.getElementById("region-select").value;
      var total = parseInt(rubro) + (reg === 'TODAS' ? 15 : 6);
      document.getElementById("licitaciones-resultado").innerHTML = "⚡ " + total + " licitaciones activas ahora mismo calzan contigo en " + reg;
    }

    function calcularCostoNoSaber() {
      var rubro = document.getElementById("rubro-calc").value;
      var card = document.getElementById("calc-resultado-card");
      var lic = document.getElementById("calc-licitaciones");
      var mar = document.getElementById("calc-marcas");
      var pub = document.getElementById("calc-publicaciones");

      var dataMap = {
        construccion: [28, 5, 4],
        aseo: [18, 4, 3],
        tecnologia: [22, 7, 2],
        salud: [15, 3, 5],
        transporte: [19, 4, 3]
      };

      var val = dataMap[rubro] || [15, 3, 2];
      lic.textContent = val[0];
      mar.textContent = val[1];
      pub.textContent = val[2];
      card.style.display = "block";
    }

    async function handleSubscribe(e) {
      e.preventDefault();
      const nombre = document.getElementById('subNombre').value;
      const correo = document.getElementById('subCorreo').value;
      const feedback = document.getElementById('subFeedback');
      
      feedback.className = 'subscription-feedback';
      feedback.style.display = 'none';

      try {
        const response = await fetch('/api/suscribir', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre, correo })
        });
        const res = await response.json();
        
        if (res.success) {
          feedback.textContent = res.message;
          feedback.classList.add('success');
          document.getElementById('subscribeForm').reset();
        } else {
          feedback.textContent = res.message || 'Error al suscribir.';
          feedback.classList.add('error');
        }
      } catch (err) {
        feedback.textContent = 'Ocurrió un error de conexión. Inténtalo de nuevo.';
        feedback.classList.add('error');
      }
    }
  </script>

