<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quantus Chile SpA | Inteligencia Empresarial & Monitoreo 24/7</title>
  <meta name="description" content="Quantus combina gestión empresarial, automatización e inteligencia artificial en un solo ecosistema para pymes chilenas.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://www.quantuschile.cl/">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Quantus Chile SpA">
  <meta property="og:title" content="Quantus Chile SpA | Inteligencia Empresarial & Monitoreo 24/7">
  <meta property="og:description" content="Vigilancia del Diario Oficial, licitaciones, marcas y automatización con IA para pymes chilenas. Observamos, analizamos y trabajamos por tu empresa las 24 horas.">
  <meta property="og:url" content="https://www.quantuschile.cl/">
  <meta property="og:image" content="https://www.quantuschile.cl/static/quantus-logo-clean.png">
  <meta property="og:locale" content="es_CL">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="Quantus Chile SpA | Inteligencia Empresarial & Monitoreo 24/7">
  <meta name="twitter:description" content="Vigilancia del Diario Oficial, licitaciones, marcas y automatización con IA para pymes chilenas.">
  <link rel="icon" type="image/png" href="{{ url_for('static', filename='quantus-logo-clean.png') }}">
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
  <style>
    :root {
      --bg-white: #ffffff;
      --bg-slate: #f8fafc;
      --card-border: #e2e8f0;
      --cyan-bright: #0284c7;
      --text-main: #0f172a;
      --text-muted: #64748b;
    }

    body {
      background-color: #ffffff;
      color: #0f172a;
      margin: 0;
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
    }

    /* SECCIÓN PRINCIPAL SPLIT (DOBLE COLUMNA) */
    .main-landing-section {
      padding: 40px 0 60px;
      background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
      border-bottom: 1px solid #e2e8f0;
    }

    .main-landing-shell {
      width: min(calc(100% - 48px), 1320px);
      margin: 0 auto;
    }

    .hero-split-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 48px;
      align-items: start;
    }

    /* COLUMNA IZQUIERDA */
    .hero-left-col {
      text-align: left;
    }

    .eyebrow-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      border-radius: 999px;
      background: rgba(2, 132, 199, 0.08);
      border: 1.5px solid rgba(2, 132, 199, 0.25);
      color: #0284c7;
      font-size: 11.5px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    .eyebrow-pill::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background: #0284c7;
      box-shadow: 0 0 8px rgba(2, 132, 199, 0.6);
    }

    .hero-h1-title {
      font-size: clamp(34px, 4vw, 54px);
      line-height: 1.1;
      font-weight: 900;
      letter-spacing: -0.035em;
      color: #0f172a;
      margin: 0 0 20px;
    }

    .hero-gradient-text {
      background: linear-gradient(135deg, #0284c7 0%, #2563eb 45%, #7e22ce 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      color: #0284c7;
      font-weight: 900;
      display: inline-block;
    }

    .hero-lead-paragraph {
      font-size: 17.5px;
      line-height: 1.55;
      color: #475569;
      margin: 0 0 24px;
      font-weight: 500;
      max-width: 660px;
    }

    /* 4 PILLS RÁPIDAS */
    .quick-pills-row {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }

    .quick-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 15px;
      border-radius: 999px;
      background: #f1f5f9;
      border: 1px solid #e2e8f0;
      color: #0284c7;
      font-size: 13px;
      font-weight: 750;
    }

    /* 4 CTAS POR DOLOR ADICIONALES EN HERO */
    .pain-ctas-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-bottom: 32px;
    }

    .pain-cta-card {
      background: #ffffff;
      border: 1.5px solid #e2e8f0;
      border-radius: 14px;
      padding: 14px 16px;
      text-decoration: none;
      color: #0f172a;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
      transition: all 0.2s ease;
      cursor: pointer;
    }
    .pain-cta-card:hover {
      border-color: #0284c7;
      background: rgba(2, 132, 199, 0.04);
      transform: translateY(-2px);
    }
    .pain-cta-label {
      font-size: 13.5px;
      font-weight: 800;
      color: #0f172a;
    }
    .pain-cta-arrow {
      color: #0284c7;
      font-weight: 900;
    }

    /* BLOQUE MONITOREO DENTRO DE COLUMNA IZQUIERDA */
    .left-monitoring-block {
      margin-top: 10px;
    }

    .monitoring-h2 {
      font-size: clamp(26px, 3vw, 36px);
      line-height: 1.18;
      font-weight: 900;
      color: #0f172a;
      letter-spacing: -0.025em;
      margin: 0 0 12px;
    }

    .monitoring-lead {
      font-size: 15.5px;
      line-height: 1.55;
      color: #64748b;
      margin: 0 0 28px;
      font-weight: 500;
    }

    /* 4 BULLETS GRID */
    .bullets-4grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-bottom: 28px;
    }

    .bullet-card-item {
      background: #ffffff;
      border-radius: 18px;
      padding: 20px 18px;
      border: 1.5px solid #e2e8f0;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.03);
      transition: all 0.2s ease;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .bullet-card-item:hover {
      border-color: #0284c7;
      box-shadow: 0 8px 24px rgba(2, 132, 199, 0.1);
      transform: translateY(-2px);
    }

    .bullet-icon-box {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: rgba(2, 132, 199, 0.08);
      border: 1px solid rgba(2, 132, 199, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }

    .bullet-text-box h4 {
      font-size: 15.5px;
      font-weight: 800;
      color: #0f172a;
      margin: 0 0 6px;
    }

    .bullet-text-box p {
      font-size: 12.5px;
      line-height: 1.45;
      color: #64748b;
      margin: 0;
      font-weight: 500;
    }

    /* BARRA CTA IZQUIERDA */
    .left-cta-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      background: #ffffff;
      border: 1.5px solid #e2e8f0;
      border-radius: 20px;
      padding: 20px 24px;
      box-shadow: 0 6px 20px rgba(15, 23, 42, 0.04);
    }

    .cta-left-content {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .cta-bar-icon {
      width: 46px;
      height: 46px;
      border-radius: 14px;
      background: rgba(2, 132, 199, 0.1);
      border: 1.5px solid rgba(2, 132, 199, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      flex-shrink: 0;
    }

    .cta-bar-text h5 {
      font-size: 16px;
      font-weight: 900;
      color: #0f172a;
      margin: 0 0 4px;
    }

    .cta-bar-text p {
      font-size: 13px;
      color: #64748b;
      margin: 0;
      font-weight: 500;
    }

    .btn-cta-secondary {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 12px 22px;
      border-radius: 12px;
      background: #ffffff;
      border: 1.5px solid #cbd5e1;
      color: #0f172a;
      font-size: 13.5px;
      font-weight: 800;
      text-decoration: none;
      white-space: nowrap;
      transition: all 0.2s ease;
    }

    .btn-cta-secondary:hover {
      border-color: #0284c7;
      color: #0284c7;
      background: rgba(2, 132, 199, 0.04);
    }

    /* COLUMNA DERECHA (IPHONE MOCKUP CON 5 CARDS) */
    .hero-right-col {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .iphone-header-intro {
      text-align: center;
      margin-bottom: 20px;
    }

    .iphone-header-intro h3 {
      font-size: 20px;
      font-weight: 900;
      color: #0f172a;
      margin: 0 0 6px;
    }

    .iphone-header-intro p {
      font-size: 13px;
      color: #64748b;
      margin: 0;
      max-width: 380px;
      font-weight: 500;
    }

    .iphone-frame-wrapper {
      position: relative;
    }

    .iphone-body {
      width: 380px;
      height: 740px;
      background: #0f172a;
      border-radius: 48px;
      padding: 12px;
      box-shadow: 0 30px 90px rgba(15, 23, 42, 0.25), 0 0 0 4px #cbd5e1, 0 0 40px rgba(2, 132, 199, 0.25);
      position: relative;
    }

    .iphone-display {
      width: 100%;
      height: 100%;
      background: #f1f5f9;
      border-radius: 36px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      position: relative;
      border: 1px solid #e2e8f0;
    }

    .iphone-top-notch {
      width: 110px;
      height: 20px;
      background: #0f172a;
      border-bottom-left-radius: 12px;
      border-bottom-right-radius: 12px;
      margin: 0 auto;
      position: relative;
      z-index: 10;
    }

    .iphone-time-bar {
      display: flex;
      justify-content: space-between;
      padding: 4px 20px 4px;
      font-size: 11px;
      font-weight: 800;
      color: #0f172a;
    }

    .iphone-header-bar {
      padding: 10px 16px;
      background: #ffffff;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .iphone-avatar-box {
      width: 32px;
      height: 32px;
      border-radius: 10px;
      background: #06101e;
      border: 1px solid #0284c7;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 10px rgba(2, 132, 199, 0.4);
    }

    .iphone-avatar-box img {
      width: 22px;
      height: 22px;
      object-fit: contain;
    }

    .iphone-app-name {
      font-size: 13px;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.1;
    }

    .iphone-app-sub {
      font-size: 10.5px;
      color: #0284c7;
      font-weight: 700;
    }

    .iphone-notifications-stack {
      flex: 1;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      overflow-y: auto;
    }

    .iphone-notif-bubble {
      background: #ffffff;
      border-radius: 16px;
      padding: 12px 14px;
      border: 1.5px solid #e2e8f0;
      box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .notif-top-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .notif-badge {
      font-size: 9.5px;
      font-weight: 900;
      padding: 3px 8px;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .tag-do { background: rgba(2, 132, 199, 0.12); color: #0284c7; }
    .tag-mp { background: rgba(37, 99, 235, 0.12); color: #2563eb; }
    .tag-inapi { background: rgba(217, 119, 6, 0.12); color: #d97706; }
    .tag-remates { background: rgba(22, 163, 74, 0.12); color: #16a34a; }
    .tag-erp { background: rgba(126, 34, 206, 0.12); color: #7e22ce; }

    .notif-time-ago {
      font-size: 10.5px;
      color: #94a3b8;
      font-weight: 600;
    }

    .notif-bold-title {
      font-size: 12.5px;
      font-weight: 800;
      color: #0f172a;
    }

    .notif-desc {
      font-size: 11.5px;
      line-height: 1.4;
      color: #64748b;
      font-weight: 500;
    }

    .notif-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 6px 12px;
      border-radius: 8px;
      background: #0f172a;
      color: #ffffff;
      font-size: 11px;
      font-weight: 800;
      text-decoration: none;
      width: fit-content;
      margin-top: 4px;
    }

    /* BARRA DE MÉTRICAS INFERIOR (3 COLUMNAS HORIZONTALES) */
    .bottom-metrics-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 50px;
      padding-top: 40px;
      border-top: 1.5px solid #e2e8f0;
    }

    .metric-card {
      background: #ffffff;
      border-radius: 20px;
      padding: 24px 28px;
      border: 1.5px solid #e2e8f0;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .metric-icon-circle {
      width: 52px;
      height: 52px;
      border-radius: 16px;
      background: rgba(2, 132, 199, 0.08);
      border: 1.5px solid rgba(2, 132, 199, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      flex-shrink: 0;
    }

    .metric-number {
      font-size: 32px;
      font-weight: 900;
      color: #0284c7;
      line-height: 1.05;
      letter-spacing: -0.02em;
    }

    .metric-label {
      font-size: 15px;
      font-weight: 800;
      color: #0f172a;
      margin-top: 2px;
    }

    .metric-sub {
      font-size: 12.5px;
      color: #64748b;
      margin-top: 4px;
      font-weight: 500;
    }

    /* WIDGET PREMIUM DIARIO OFICIAL */
    .premium-widgets-section {
      margin-top: 45px;
      padding-top: 35px;
      border-top: 1.5px solid #e2e8f0;
      text-align: left;
    }

    .do-square-card {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
      background: #ffffff;
      border: 2px solid #e2e8f0;
      border-radius: 24px;
      padding: 32px 36px;
      width: min(100%, 460px);
      box-shadow: 0 8px 30px rgba(15, 23, 42, 0.06);
      transition: all 0.25s ease;
    }

    .do-square-card:hover {
      border-color: #0284c7;
      box-shadow: 0 16px 40px rgba(2, 132, 199, 0.16);
      transform: translateY(-3px);
    }

    .do-square-logo {
      height: 52px;
      width: auto;
      object-fit: contain;
      display: block;
    }

    .do-square-title {
      font-size: 22px;
      font-weight: 900;
      color: #0f172a;
      line-height: 1.25;
      letter-spacing: -0.02em;
    }

    .do-square-subtitle {
      font-size: 14px;
      line-height: 1.5;
      color: #64748b;
      margin: 0;
      font-weight: 500;
    }

    .btn-do-action-square {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 13px 26px;
      border-radius: 12px;
      background: #0284c7;
      color: #ffffff;
      font-size: 14.5px;
      font-weight: 800;
      text-decoration: none;
      width: 100%;
      box-shadow: 0 6px 20px rgba(2, 132, 199, 0.25);
      transition: all 0.2s ease;
    }

    .btn-do-action-square:hover {
      background: #0369a1;
      transform: translateY(-1px);
    }

    /* SECCIONES VERTICALES DE INFORMACIÓN ADICIONAL */
    .vertical-section {
      padding: 64px 0;
      background: #ffffff;
      color: #0f172a;
      border-top: 1px solid #e2e8f0;
    }
    .vertical-section.alt-bg {
      background: #f8fafc;
    }

    .vertical-shell {
      width: min(calc(100% - 48px), 1280px);
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: center;
    }

    .vertical-copy h2 {
      font-size: clamp(26px, 2.8vw, 38px);
      font-weight: 900;
      color: #0f172a;
      line-height: 1.18;
      margin: 0 0 16px;
      letter-spacing: -0.02em;
    }

    .vertical-copy p {
      font-size: 15.5px;
      line-height: 1.6;
      color: #475569;
      margin: 0 0 24px;
    }

    .btn-vertical-action {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 13px 26px;
      border-radius: 12px;
      background: #0284c7;
      color: #ffffff;
      font-size: 14.5px;
      font-weight: 800;
      text-decoration: none;
      box-shadow: 0 6px 20px rgba(2, 132, 199, 0.25);
      transition: all 0.2s ease;
    }

    /* WIDGETS Y CALCULADORA DE COSTO DE NO SABER */
    .radar-widget-box {
      background: #ffffff;
      border: 2px solid #e2e8f0;
      border-radius: 20px;
      padding: 28px;
      box-shadow: 0 12px 32px rgba(15, 23, 42, 0.05);
    }

    .calculator-section {
      padding: 70px 0;
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      color: #ffffff;
      border-radius: 28px;
      margin: 50px auto 30px;
      max-width: 1280px;
    }

    /* SECCIÓN FORMULARIO SUSCRIPCIÓN NEWSLETTER */
    .newsletter-section {
      margin-top: 60px;
      padding: 48px 40px;
      border-radius: 28px;
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      color: #ffffff;
      box-shadow: 0 20px 50px rgba(15, 23, 42, 0.15);
      text-align: center;
    }

    .newsletter-shell h3 {
      font-size: clamp(24px, 3vw, 34px);
      font-weight: 900;
      margin: 0 0 10px;
      letter-spacing: -0.02em;
    }

    .newsletter-shell p {
      font-size: 15.5px;
      color: #94a3b8;
      margin: 0 auto 30px;
      max-width: 620px;
      line-height: 1.55;
    }

    .newsletter-form {
      display: flex;
      justify-content: center;
      gap: 14px;
      max-width: 680px;
      margin: 0 auto 16px;
      flex-wrap: wrap;
    }

    .newsletter-input {
      padding: 14px 18px;
      border-radius: 12px;
      border: 1.5px solid #334155;
      background: #0f172a;
      color: #ffffff;
      font-size: 14.5px;
      font-family: inherit;
      outline: none;
      flex: 1;
      min-width: 200px;
      transition: border-color 0.2s;
    }

    .newsletter-input:focus {
      border-color: #0284c7;
    }

    .newsletter-input::placeholder {
      color: #64748b;
    }

    .btn-subscribe {
      padding: 14px 28px;
      border-radius: 12px;
      background: linear-gradient(135deg, #0284c7 0%, #2563eb 100%);
      color: #ffffff;
      font-size: 15px;
      font-weight: 800;
      border: none;
      cursor: pointer;
      font-family: inherit;
      white-space: nowrap;
      box-shadow: 0 8px 20px rgba(2, 132, 199, 0.4);
      transition: all 0.2s ease;
    }

    .btn-subscribe:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(2, 132, 199, 0.55);
    }

    .newsletter-privacy-note {
      font-size: 12px;
      color: #64748b;
      margin: 0;
    }

    .subscription-feedback {
      display: none;
      padding: 12px 20px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 750;
      margin-top: 14px;
      max-width: 600px;
      margin-inline: auto;
    }

    .subscription-feedback.success {
      display: block !important;
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.4);
      color: #34d399;
    }

    .subscription-feedback.error {
      display: block !important;
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: #f87171;
    }

    @media (max-width: 1100px) {
      .hero-split-grid, .vertical-shell {
        grid-template-columns: 1fr;
      }
      .bullets-4grid, .pain-ctas-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .bottom-metrics-grid {
        grid-template-columns: 1fr;
      }
      .newsletter-form {
        flex-direction: column;
      }
    }
  </style>
</head>
<body>

  {% include "partials/nav_header.html" %}

  <main>
    <section class="main-landing-section">
      <div class="main-landing-shell">
        <!-- GRID DOBLE COLUMNA HERO ORIGINAL + IPHONE -->
        <div class="hero-split-grid">
          
          <!-- COLUMNA IZQUIERDA -->
          <div class="hero-left-col">
