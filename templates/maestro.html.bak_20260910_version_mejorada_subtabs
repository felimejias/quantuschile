  <script>
    const clientSearch = document.getElementById("clientSearch");
    const clientsTable = document.getElementById("clientsTable");
    if (clientSearch && clientsTable) {
      clientSearch.addEventListener("input", () => {
        const query = clientSearch.value.trim().toLowerCase();
        clientsTable.querySelectorAll("tbody tr").forEach((row) => {
          row.style.display = row.textContent.toLowerCase().includes(query) ? "" : "none";
        });
      });
    }
    document.querySelectorAll(".registry-delete-form").forEach((form) => {
      form.addEventListener("submit", (e) => {
        const name = form.getAttribute("data-name") || "este registro";
        if (!window.confirm("¿Eliminar del Registro Maestro RUT a \"" + name + "\"?\nSe borrará su registro transversal y el origen de datos correspondiente. Esta acción no se puede deshacer.")) {
          e.preventDefault();
        }
      });
    });
    document.querySelectorAll(".module-delete-form").forEach((form) => {
      form.addEventListener("submit", (e) => {
        const name = form.getAttribute("data-name") || "esta funcionalidad";
        if (!window.confirm("¿Eliminar \"" + name + "\" del Panel SuperAdmin?\nEsto borra el registro de control, no el código del sistema.")) {
          e.preventDefault();
        }
      });
    });
    const checkAll = document.getElementById("registry-check-all");
    const bulkForm = document.querySelector(".registry-bulk-form");
    const bulkBtn = bulkForm ? bulkForm.querySelector(".registry-bulk-btn") : null;
    function registrySelectedKeys() {
      return Array.from(document.querySelectorAll(".registry-check:checked")).map((cb) => cb.value);
    }
    function updateRegistryBulkState() {
      if (!bulkBtn) return;
      const n = registrySelectedKeys().length;
      bulkBtn.disabled = n === 0;
      bulkBtn.textContent = "Eliminar seleccionados (" + n + ")";
      if (checkAll) {
        const checks = document.querySelectorAll(".registry-check");
        checkAll.checked = checks.length > 0 && checks.length === document.querySelectorAll(".registry-check:checked").length;
        checkAll.indeterminate = n > 0 && n < checks.length;
      }
    }
    document.querySelectorAll(".registry-check").forEach((cb) => cb.addEventListener("change", updateRegistryBulkState));
    if (checkAll) {
      checkAll.addEventListener("change", () => {
        document.querySelectorAll(".registry-check").forEach((cb) => { cb.checked = checkAll.checked; });
        updateRegistryBulkState();
      });
    }
    if (bulkForm) {
      bulkForm.addEventListener("submit", (e) => {
        const keys = registrySelectedKeys();
        if (keys.length === 0) {
          e.preventDefault();
          return;
        }
        if (!window.confirm("¿Eliminar del Registro Maestro RUT a " + keys.length + " usuario(s)?\nSe borrará su registro transversal y su origen de datos correspondiente. Esta acción no se puede deshacer.")) {
          e.preventDefault();
          return;
        }
        bulkForm.querySelector("input[name='registry_keys']").value = JSON.stringify(keys);
      });
    }
    const modalOverlay = document.getElementById("registry-modal-overlay");
    const editForm = document.getElementById("registry-edit-form");
    const modalClose = document.getElementById("registry-modal-close");
    const modalCancel = document.getElementById("registry-modal-cancel");
    function openRegistryModal() {
      if (modalOverlay) modalOverlay.classList.add("open");
    }
    function closeRegistryModal() {
      if (modalOverlay) modalOverlay.classList.remove("open");
    }
    document.querySelectorAll(".registry-edit-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.getElementById("reg-edit-key").value = btn.getAttribute("data-key") || "";
        document.getElementById("reg-edit-nombre").value = btn.getAttribute("data-nombre") || "";
        document.getElementById("reg-edit-rut").value = btn.getAttribute("data-rut") || "";
        document.getElementById("reg-edit-email").value = btn.getAttribute("data-email") || "";
        document.getElementById("reg-edit-whatsapp").value = btn.getAttribute("data-whatsapp") || "";
        const estado = document.getElementById("reg-edit-estado");
        const actual = btn.getAttribute("data-estado") || "activo";
        let found = false;
        Array.from(estado.options).forEach((opt) => { if (opt.value === actual) { opt.selected = true; found = true; } });
        if (!found) {
          const opt = document.createElement("option");
          opt.value = actual; opt.textContent = actual; opt.selected = true;
          estado.appendChild(opt);
        }
        editForm.action = "/maestro/registro/" + encodeURIComponent(btn.getAttribute("data-key")) + "/modificar";
        openRegistryModal();
      });
    });
    if (modalClose) modalClose.addEventListener("click", closeRegistryModal);
    if (modalCancel) modalCancel.addEventListener("click", closeRegistryModal);
    if (modalOverlay) {
      modalOverlay.addEventListener("click", (e) => { if (e.target === modalOverlay) closeRegistryModal(); });
    }
  </script>
