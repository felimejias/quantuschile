<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Centro Maestro Quantus | Analytics</title>
  <link rel="icon" type="image/png" href="{{ url_for('static', filename='quantus-logo-clean.png') }}">
  <meta name="theme-color" content="#06101f">
  <meta name="csrf-token" content="{{ csrf_token() }}">
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}?v=20260729-maestro">
  <style>
    .registry-modal-overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(6, 16, 31, 0.82);
      backdrop-filter: blur(6px);
      z-index: 99990;
      align-items: center;
      justify-content: center;
      padding: 20px;
      box-sizing: border-box;
    }
    .registry-modal-overlay.open { display: flex; }
    .registry-modal {
      background: #0f172a;
      border: 1px solid rgba(56, 189, 248, 0.35);
      border-radius: 18px;
      width: 100%;
      max-width: 480px;
      padding: 22px;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.7);
      position: relative;
      color: #f8fafc;
      max-height: 90vh;
      overflow-y: auto;
    }
    .registry-modal h3 { margin: 0 0 4px; font-size: 18px; }
    .registry-modal p { margin: 0 0 16px; color: #94a3b8; font-size: 13px; }
    .registry-modal .form-group { margin-bottom: 12px; }
    .registry-modal label { display: block; font-size: 12px; font-weight: 700; color: #cbd5e1; margin-bottom: 5px; }
    .registry-modal .form-control { width: 100%; box-sizing: border-box; padding: 10px 12px; background: #1e293b; border: 1px solid rgba(148,163,184,0.3); border-radius: 10px; color: #fff; font-size: 14px; outline: none; }
    .registry-modal .form-control:focus { border-color: #38bdf8; box-shadow: 0 0 0 3px rgba(56,189,248,0.2); }
    .registry-modal-actions { display: flex; gap: 10px; margin-top: 16px; }
    .registry-modal-actions .btn { flex: 1; }
    .registry-close-btn {
      position: absolute; top: 12px; right: 14px;
      background: none; border: none; color: #94a3b8; font-size: 22px; cursor: pointer; line-height: 1;
    }
    .registry-close-btn:hover { color: #fff; }
    .registry-float-alert {
      position: fixed;
      bottom: 20px; right: 20px;
      z-index: 99980;
      max-width: 360px;
      background: rgba(30, 20, 4, 0.95);
      border: 1px solid rgba(245, 158, 11, 0.45);
      border-radius: 14px;
      padding: 12px 14px;
      box-shadow: 0 18px 44px rgba(0, 0, 0, 0.55);
      color: #fde68a;
      font-size: 13px;
      line-height: 1.5;
    }
    .registry-float-alert strong { color: #fbbf24; }
    .registry-float-alert ul { margin: 8px 0 0; padding-left: 18px; max-height: 160px; overflow-y: auto; }
    .registry-float-alert .dismiss {
      position: absolute; top: 8px; right: 10px;
      background: none; border: none; color: #fbbf24; font-size: 16px; cursor: pointer; line-height: 1;
    }
    .superadmin-control-grid {
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      gap: 14px;
      align-items: start;
    }
    .superadmin-summary {
      display: grid;
      grid-template-columns: repeat(5, minmax(90px, 1fr));
      gap: 10px;
      margin: 14px 0;
    }
    .superadmin-summary div {
      background: rgba(15, 23, 42, .78);
      border: 1px solid rgba(148, 163, 184, .22);
      border-radius: 8px;
      padding: 10px;
    }
    .superadmin-summary span {
      display: block;
      color: #94a3b8;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
    }
    .superadmin-summary strong { font-size: 22px; color: #f8fafc; }
    .superadmin-actions-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 10px;
      margin-top: 10px;
    }
    .superadmin-action-card {
      display: block;
      min-height: 88px;
      padding: 12px;
      border: 1px solid rgba(56, 189, 248, .28);
      border-radius: 8px;
      background: rgba(8, 16, 33, .8);
      color: #e2e8f0;
      text-decoration: none;
    }
    .superadmin-action-card strong { display: block; color: #fff; margin-bottom: 4px; }
    .superadmin-action-card span { display: block; color: #94a3b8; font-size: 12px; line-height: 1.35; }
    .module-admin-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }
    .module-admin-form .wide { grid-column: 1 / -1; }
    .module-admin-form label {
      display: grid;
      gap: 5px;
      color: #94a3b8;
      font-size: 11px;
      font-weight: 800;
    }
    .module-admin-form input,
    .module-admin-form select,
    .module-admin-form textarea {
      width: 100%;
      background: #0f172a;
      border: 1px solid rgba(148, 163, 184, .28);
      border-radius: 8px;
      color: #f8fafc;
      padding: 8px 10px;
      font-size: 12px;
    }
    .module-row-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
    }
    .module-edit-details {
      margin-top: 8px;
      border-top: 1px solid rgba(148, 163, 184, .18);
      padding-top: 8px;
    }
    .module-edit-details summary {
      cursor: pointer;
      color: #38bdf8;
      font-size: 12px;
      font-weight: 900;
    }
    .superadmin-add-panel {
      background: rgba(8, 16, 33, .72);
      border: 1px solid rgba(148, 163, 184, .2);
      border-radius: 8px;
      padding: 14px;
    }
    .superadmin-add-panel h3 {
      margin: 0 0 4px;
      font-size: 18px;
      color: #f8fafc;
    }
    .superadmin-add-panel p {
      margin: 0 0 12px;
      color: #94a3b8;
      font-size: 13px;
    }
    .demo-access-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      align-items: start;
    }
    .demo-access-card {
      background: rgba(8, 16, 33, .72);
      border: 1px solid rgba(56, 189, 248, .24);
      border-radius: 8px;
      padding: 14px;
    }
    .demo-access-card h3 {
      margin: 0 0 4px;
      font-size: 17px;
      color: #f8fafc;
    }
    .demo-access-card p,
    .demo-protocol li {
      color: #94a3b8;
      font-size: 13px;
      line-height: 1.45;
    }
    .demo-protocol {
      margin: 10px 0 0;
      padding-left: 18px;
    }
    .demo-access-result {
      margin: 14px 0;
      padding: 12px;
      background: rgba(34, 197, 94, .12);
      border: 1px solid rgba(34, 197, 94, .38);
      border-radius: 8px;
      color: #dcfce7;
      font-size: 13px;
      line-height: 1.5;
    }
    .demo-access-result code {
      display: inline-block;
      margin: 2px 4px 2px 0;
      padding: 3px 6px;
      border-radius: 6px;
      background: rgba(15, 23, 42, .85);
      color: #f8fafc;
    }
    .status-pill {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 4px 8px;
      font-size: 11px;
      font-weight: 900;
      border: 1px solid rgba(148, 163, 184, .28);
      color: #cbd5e1;
      background: rgba(15, 23, 42, .7);
    }
    .status-pill.produccion { color:#86efac; border-color:rgba(34,197,94,.5); background:rgba(22,101,52,.2); }
    .status-pill.piloto { color:#93c5fd; border-color:rgba(59,130,246,.5); background:rgba(30,64,175,.2); }
    .status-pill.demo { color:#fde68a; border-color:rgba(245,158,11,.5); background:rgba(120,53,15,.2); }
    .status-pill.block { color:#fca5a5; border-color:rgba(239,68,68,.55); background:rgba(127,29,29,.22); }
    .status-pill.externo, .status-pill.mock { color:#d8b4fe; border-color:rgba(168,85,247,.5); background:rgba(88,28,135,.2); }
    @media (max-width: 980px) {
      .superadmin-control-grid,
      .demo-access-grid,
      .module-admin-form { grid-template-columns: 1fr; }
      .superadmin-summary { grid-template-columns: repeat(2, minmax(110px, 1fr)); }
    }
  
    .master-subtabs-nav {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding: 10px 4px 14px;
      margin: 12px 0 16px;
      border-bottom: 1px solid rgba(148, 163, 184, 0.18);
      scrollbar-width: thin;
    }
    .subtab-item {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 15px;
      font-size: 13px;
      font-weight: 600;
      color: #94a3b8;
      background: rgba(15, 23, 42, 0.7);
      border: 1px solid rgba(148, 163, 184, 0.15);
      border-radius: 9px;
      text-decoration: none;
      white-space: nowrap;
      transition: all 0.2s ease;
    }
    .subtab-item:hover {
      color: #38bdf8;
      background: rgba(56, 189, 248, 0.12);
      border-color: rgba(56, 189, 248, 0.4);
      transform: translateY(-1px);
    }
    .subtab-item.active {
      color: #f8fafc;
      background: linear-gradient(135deg, rgba(2, 132, 199, 0.28), rgba(15, 23, 42, 0.9));
      border-color: #38bdf8;
      box-shadow: 0 0 14px rgba(56, 189, 248, 0.3);
    }

  </style>
</head>
<body>
  <div class="app-container master-shell">
    <header class="app-header master-header">
      <a class="brand-link" href="/maestro">
        <img class="brand-logo" src="{{ url_for('static', filename='quantus-logo-clean.png') }}" alt="Quantus Chile">
        <div>
        <div class="logo-text">QUANTUS CHILE</div>
          <div class="logo-subtitle">Centro Maestro SuperAdmin</div>
        </div>
      </a>
      <nav class="header-actions">
        <a class="cta-button btn-secondary" href="/maestro/servidores" style="border-color:#38bdf8; color:#38bdf8; display:inline-flex; align-items:center; gap:6px;">
          <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#22c55e; box-shadow:0 0 8px #22c55e;"></span>
          🖥️ Servidores Multi-Cloud
        </a>
        <a class="cta-button btn-secondary" href="#panel-superadmin">SuperAdmin</a>
        <a class="cta-button btn-secondary" href="/clientes">Punto de Venta</a>
        <a class="cta-button btn-secondary" href="/inapi">INAPI</a>
        <a class="cta-button btn-secondary" href="/do">Diario Oficial</a>
        <a class="cta-button btn-secondary" href="/licitaciones">Licitaciones</a>
        <a class="cta-button btn-secondary" href="/maestro/tributario">Tributario Quantus</a>
        <a class="cta-button btn-secondary" href="/maestro/geointel">GeoIntel</a>
        <a class="cta-button" href="/maestro/logout">Salir</a>
      </nav>
    </header>

    <!-- BARRA DE SUBPESTAÑAS MAESTRAS QUANTUS -->
    <nav class="master-subtabs-nav" aria-label="Secciones del Centro Maestro">
      <a href="/maestro" class="subtab-item active">📊 Resumen General</a>
      <a href="/maestro/servidores" class="subtab-item">🖥️ Servidores Multi-Cloud</a>
      <a href="#panel-do-historico" class="subtab-item">🏛️ Diario Oficial (25 Años)</a>
      <a href="#panel-demos" class="subtab-item">🔑 Demos Temporales</a>
      <a href="#panel-superadmin" class="subtab-item">⚙️ SuperAdmin Módulos</a>
      <a href="#panel-clientes-cuentas" class="subtab-item">👥 Clientes & Cuentas</a>
      <a href="/maestro/geointel" class="subtab-item">🗺️ GeoIntel</a>
      <a href="/maestro/tributario" class="subtab-item">🧾 Tributario</a>
    </nav>


    <section class="proof-panel" style="margin: 16px 0;">
      <div class="panel-title">
        <div>
          <h2>Crear usuarios gratis por radar</h2>
          <p>Alta separada por servicio, con verificación de contacto y valor mensual cero.</p>
        </div>
        <span class="badge badge-info">{{ snapshot.totals.free_clients }} gratis activos</span>
      </div>
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:12px;">
        {% set radar_cards = [
          {"key":"diario_oficial","title":"Diario Oficial","accent":"#38bdf8","hint":"Alias, empresas o personas asociadas","button":"Crear gratis DO"},
          {"key":"licitaciones","title":"Licitaciones","accent":"#22c55e","hint":"Rubros, regiones, montos u organismos","button":"Crear gratis Licitaciones"},
          {"key":"remates","title":"Remates","accent":"#f97316","hint":"Region, comuna, banco o tipo de inmueble","button":"Crear gratis Remates"},
          {"key":"inapi","title":"INAPI","accent":"#a855f7","hint":"Marca, clase, titular o rubro","button":"Crear gratis INAPI"}
        ] %}
        {% for radar in radar_cards %}
        <article style="background:rgba(15,23,42,0.95); border:1px solid {{ radar.accent }}66; border-radius:8px; padding:14px;">
          <div style="display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:10px;">
            <strong style="color:{{ radar.accent }};">{{ radar.title }}</strong>
            <span class="badge badge-info">{{ snapshot.free_by_module.get(radar.key, 0) }} gratis</span>
          </div>
          <form action="/maestro/agregar-cliente-gratis" method="POST" style="display:grid; gap:8px;">
            {{ csrf_input()|safe }}
            <input type="hidden" name="modulo" value="{{ radar.key }}">
            <input type="text" name="rut" class="form-control" placeholder="RUT a vigilar *" required data-rut style="padding:8px 10px; font-size:12px; border-color:{{ radar.accent }};">
            <input type="text" name="nombre" class="form-control" placeholder="Nombre o razon social" style="padding:8px 10px; font-size:12px;">
            <input type="email" name="email" class="form-control" placeholder="Correo verificado *" required style="padding:8px 10px; font-size:12px;">
            <input type="tel" name="whatsapp" class="form-control" placeholder="WhatsApp +569..." required pattern="^(\+?569|9)[0-9]{8}$" title="Ingresa un numero celular chileno valido" style="padding:8px 10px; font-size:12px;">
            <input type="text" name="rubros" class="form-control" placeholder="{{ radar.hint }}" style="padding:8px 10px; font-size:12px;">
            <button type="submit" class="cta-button" style="padding:9px 12px; font-size:12px;">{{ radar.button }}</button>
          </form>
        </article>
        {% endfor %}
      </div>
    </section>


    <section class="master-hero">
      <div>
        <span class="eyebrow"><span class="eyebrow-dot"></span> Operación ejecutiva privada</span>
        <h1 class="hero-title">Control maestro <span>Quantus Intelligence</span></h1>
        <p class="hero-subtitle">
          Vista unificada de Diario Oficial, INAPI, Licitaciones, ERP y agentes IA. Los ingresos se muestran como estimación operativa hasta conectar confirmación automática de Mercado Pago.
        </p>
      </div>
      <div class="master-status-panel">
        <span>Sesión</span>
        <strong>{{ user }}</strong>
        <small>Actualizado {{ snapshot.generated_at }}</small>
        <small data-passkey-status>Touch ID disponible como passkey del navegador.</small>
      </div>
    </section>

    <!-- MINI MONITOR COMPACTO DE INFRAESTRUCTURA MULTI-CLOUD -->
    <section class="proof-panel" style="margin: 14px 0; padding: 14px 18px; border: 1px solid rgba(56, 189, 248, 0.35); background: linear-gradient(135deg, rgba(8, 16, 33, 0.95), rgba(15, 23, 42, 0.98)); border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.35);">
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:12px;">
        <div style="display:flex; align-items:center; gap:10px;">
          <span style="display:inline-block; width:10px; height:10px; border-radius:50%; background:#22c55e; box-shadow:0 0 10px #22c55e;"></span>
          <div>
            <h3 style="margin:0; font-size:15px; color:#f8fafc; font-weight:800; letter-spacing:0.3px;">
              Salud y Redundancia Multi-Cloud (ISO 22301)
            </h3>
            <p style="margin:2px 0 0; color:#94a3b8; font-size:12px;">
              Monitoreo continuo de 3 nodos independientes: Servidor Físico + Oracle Cloud + Azure DR.
            </p>
          </div>
        </div>
        <div style="display:flex; gap:10px; align-items:center;">
          <span class="badge" style="background:rgba(34,197,94,0.15); border:1px solid #22c55e; color:#4ade80; font-weight:700; font-size:11px;">
            ● RTO &lt; 15m Sincronizado
          </span>
          <a href="/maestro/servidores" class="cta-button" style="background:#0284c7; color:#fff; border-color:#38bdf8; padding:6px 14px; font-size:12px; text-decoration:none; display:inline-flex; align-items:center; gap:6px; font-weight:700;">
            🖥️ Ver Monitor Completo en /maestro/servidores →
          </a>
        </div>
      </div>

      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:10px;">
        <!-- MINI NODO 1: FÍSICO -->
        <div style="background:rgba(15,23,42,0.85); border:1px solid rgba(56,189,248,0.25); border-radius:8px; padding:10px 12px; display:flex; justify-content:space-between; align-items:center;">
          <div>
            <strong style="color:#38bdf8; font-size:13px; display:flex; align-items:center; gap:6px;">
              🖥️ Físico On-Premise
            </strong>
            <small style="color:#94a3b8; font-size:10px; display:block; margin-top:2px;">
              100.117.44.3 · Big Data & PG Master
            </small>
            <div style="font-size:11px; color:#cbd5e1; margin-top:4px;">
              Disco: <b style="color:#4ade80;">{{ infra_snapshot.onprem.disk.used_pct if infra_snapshot else '34.8' }}%</b> · RAM: <b style="color:#38bdf8;">{{ infra_snapshot.onprem.ram.used_pct if infra_snapshot else '75' }}%</b>
            </div>
          </div>
          <span class="badge" style="background:rgba(34,197,94,0.15); border:1px solid #22c55e; color:#4ade80; font-size:10px; font-weight:700;">ONLINE</span>
        </div>

        <!-- MINI NODO 2: ORACLE -->
        <div style="background:rgba(15,23,42,0.85); border:1px solid rgba(34,197,94,0.25); border-radius:8px; padding:10px 12px; display:flex; justify-content:space-between; align-items:center;">
          <div>
            <strong style="color:#4ade80; font-size:13px; display:flex; align-items:center; gap:6px;">
              ☁️ Oracle Cloud Santiago
            </strong>
            <small style="color:#94a3b8; font-size:10px; display:block; margin-top:2px;">
              146.181.50.43 · Edge Web & ERP Nginx
            </small>
            <div style="font-size:11px; color:#cbd5e1; margin-top:4px;">
              Disco: <b style="color:#4ade80;">{{ infra_snapshot.oracle.disk.used_pct if infra_snapshot else '8.4' }}%</b> (Huella &lt; 15%)
            </div>
          </div>
          <span class="badge" style="background:rgba(34,197,94,0.15); border:1px solid #22c55e; color:#4ade80; font-size:10px; font-weight:700;">ONLINE</span>
        </div>

        <!-- MINI NODO 3: AZURE -->
        <div style="background:rgba(15,23,42,0.85); border:1px solid rgba(168,85,247,0.25); border-radius:8px; padding:10px 12px; display:flex; justify-content:space-between; align-items:center;">
          <div>
            <strong style="color:#c084fc; font-size:13px; display:flex; align-items:center; gap:6px;">
              🛡️ Azure Hot Standby
            </strong>
            <small style="color:#94a3b8; font-size:10px; display:block; margin-top:2px;">
              158.23.185.184 · Réplica DR Failover
            </small>
            <div style="font-size:11px; color:#cbd5e1; margin-top:4px;">
              Disco: <b style="color:#4ade80;">{{ infra_snapshot.azure.disk.used_pct if infra_snapshot else '4.4' }}%</b> · Túnel OK
            </div>
          </div>
          <span class="badge" style="background:rgba(168,85,247,0.15); border:1px solid #a855f7; color:#c084fc; font-size:10px; font-weight:700;">STANDBY</span>
        </div>
      </div>
    </section>

    <!-- MONITOR DE INGESTA HISTÓRICA REGRESIVA (DIARIO OFICIAL 25 AÑOS) -->
    <section class="proof-panel" id="panel-do-historico" style="margin: 18px 0; border: 1px solid rgba(56, 189, 248, 0.4); background: linear-gradient(135deg, rgba(8, 16, 33, 0.95), rgba(15, 23, 42, 0.98)); border-radius: 10px; box-shadow: 0 4px 20px rgba(0,0,0,0.35);">
      <div class="panel-title" style="margin-bottom: 12px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
        <div style="display:flex; align-items:center; gap:10px;">
          <span style="display:inline-block; width:10px; height:10px; border-radius:50%; background:#38bdf8; box-shadow:0 0 10px #38bdf8;"></span>
          <div>
            <h2 style="margin:0; font-size:16px; color:#f8fafc; font-weight:800; letter-spacing:0.3px;">
              Monitor de Ingesta Histórica Regresiva · Diario Oficial
            </h2>
            <p style="margin:3px 0 0; color:#94a3b8; font-size:12px;">
              Digitalización regresiva desde la edición de hoy hacia la primera edición digital extraíble (año 2001 · 25 años).
            </p>
          </div>
        </div>
        <div style="display:flex; gap:8px; align-items:center;">
          <span class="badge" style="background:rgba(34, 197, 94, 0.15); border:1px solid #22c55e; color:#4ade80; font-weight:700; font-size:11px;">
            ● {{ snapshot.do_regressive_progress.estado }}
          </span>
          <span class="badge badge-info" style="font-size:11px;">
            Meta Legal: 25 Años
          </span>
        </div>
      </div>

      <!-- Barra de Progreso Visual Regresiva -->
      <div style="background:rgba(15, 23, 42, 0.9); border:1px solid rgba(148, 163, 184, 0.25); border-radius:10px; padding:16px; margin-bottom:14px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; font-size:12px; font-weight:700; flex-wrap:wrap; gap:6px;">
          <span style="color:#94a3b8;">
            🏁 Meta Histórica: <strong style="color:#e2e8f0;">Edición Nº {{ snapshot.do_regressive_progress.edicion_meta }} (Año 2001)</strong>
